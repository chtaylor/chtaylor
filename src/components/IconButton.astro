---
import { Icon } from "astro-icon/components";

interface Props {
    href: string;
    text: string;
    icon?: string;
}

const { href, text, icon, ...rest } = Astro.props;

// Detect external links
const isExternal = href.startsWith("http");
const target = isExternal ? "_blank" : "_self";
const rel = isExternal ? "noopener noreferrer" : undefined;

// class="not-prose group border-ui hover:border-ui-3 flex w-full items-center justify-center gap-x-2 rounded-md border px-8 py-2 transition-all duration-300 ease-in-out hover:shadow-md"
// border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 
---

<a
    href={href}
    target={target}
    rel={rel}
    class="not-prose group flex w-full items-center justify-center gap-x-2 border px-8 py-4 dark:bg-white bg-black dark:hover:bg-white/5 hover:bg-white text-white dark:text-black hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
    {...rest}
>
    {
        icon && (
            <Icon
                name={icon}
                size={18}
                class="shrink-0 transition-colors duration-300 ease-in-out"
            />
        )
    }
    <span
        class="text-base font-semibold transition-colors duration-300 ease-in-out"
        >{text}</span
    >
</a>
